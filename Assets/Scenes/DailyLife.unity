  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreatureExperiment.Story.Day1StoryController
  dialogue: {fileID: 0}
  director: {fileID: 0}
  attendance: {fileID: 0}
  workShift: {fileID: 0}
  supervisorWarning: {fileID: 0}
  player: {fileID: 0}
  mike: {fileID: 1110674567}
  mikeSmoking: {fileID: 1110674564}
