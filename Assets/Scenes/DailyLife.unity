--- !u!102 &1740659444
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1740659441}
  m_Text: "[\uC5C5\uBB34 \uBD84\uB958 \uC548\uB0B4]\n\n1. \uB124\uBAA8 (Cube) = \uC77C\uBC18\uD488\n   
    \u2192 \uD3EC\uC7A5 + \uD14C\uC774\uD504 \u2192 \uBD84\uB958\uC644\uB8CC\uAD6C\uC5ED\n\n2.
    \uACF5 (Sphere) = \uCDE8\uAE09\uC8FC\uC758\n    \u2192 \uD3EC\uC7A5 + \uD14C\uC774\uD504
    + \uCDE8\uAE09\uC8FC\uC758 \uC2A4\uD2F0\uCEE4\n    \u2192 \uBD84\uB958\uC644\uB8CC\uAD6C\uC5ED\n\n3.
    \uBE68\uAC04 \uBB3C\uD488 = \uD3D0\uAE30\uD488 (\uBAA8\uC591 \uBB34\uAD00)\n   
    \u2192 \uD3EC\uC7A5\uD558\uC9C0 \uB9D0\uACE0 \uD3D0\uAE30\uD568"
  m_OffsetZ: 0
  m_CharacterSize: 0.0165
  m_LineSpacing: 1
  m_Anchor: 1
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 60
