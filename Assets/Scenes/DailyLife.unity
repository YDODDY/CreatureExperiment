  storeExitRoute: {fileID: 1751689611}
  returnRoute: {fileID: 1897117650}
  smokingRoute: {fileID: 744448032}
  exitRoute: {fileID: 890569887}
  mikeLeaveDistance: 40
  mikeRecallLine: "Mike: \uC57C, \uC5B4\uB514 \uAC00? \uC774\uCABD\uC774\uC57C."
  storeLeaveWithoutTalkDistance: 10
  talkReadyDistance: 4
  workplaceZone: {fileID: 1039068780}
  workAreaZone: {fileID: 1488563470}
  workAreaNarrationZone: {fileID: 1571913567}
  storeInsideZone: {fileID: 1264071017}
  storeOutsideZone: {fileID: 639168576}
  smokingZone: {fileID: 1411789468}
  homeZone: {fileID: 1577697146}
  homeNarrationZone: {fileID: 116634921}
  narrationDelay: 0.4
  narrationFallbackSeconds: 5.5
  storeExitGate: {fileID: 1793291272}
  convenienceStoreId: ConvenienceStore
  cigarettePackTemplate: {fileID: 392150916}
  offeredPackCigarettes: 6
  cigaretteContentId: Cigarette
  playOnStart: 1
  startDelay: 0.6
  beatPause: 0.6
  mikeArrivalFallbackSeconds: 25
  gameEndPause: 1
  playerSpeakerName: "\uB098"
  minLineSeconds: 0.35
  lookDuration: 0.6
  taskBreakfast: "\uC544\uCE68 \uBA39\uAE30"
  taskMeetMike: "\uD070\uAE38\uC5D0\uC11C Mike \uB9CC\uB098\uAE30"
  taskFollowMike: "Mike\uB97C \uB530\uB77C \uC9C1\uC7A5\uC73C\uB85C \uC774\uB3D9\uD558\uAE30"
  taskClockIn: "2\uCE35 \uC791\uC5C5\uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD574 \uCD9C\uADFC\uD558\uAE30"
  taskMorningWork: "\uC624\uC804 \uC791\uC5C5 \uC218\uD589\uD558\uAE30"
  taskMeetMikeDownstairs: "1\uCE35\uC5D0\uC11C Mike\uC640 \uB300\uD654\uD558\uAE30"
  taskTalkToMike: "Mike\uC640 \uB300\uD654\uD558\uAE30"
  talkTaskDistance: 6
  taskGoToStore: "\uD3B8\uC758\uC810 \uAC00\uAE30"
  taskBuyLunch: "\uC810\uC2EC\uC2DD\uC0AC \uAD6C\uC785\uD558\uAE30"
  taskBackToWork: "\uC77C\uD130\uB85C \uB3CC\uC544\uAC00\uAE30"
  taskAfternoonWork: "\uC624\uD6C4 \uC791\uC5C5 \uC218\uD589\uD558\uAE30"
  taskFollowToSmoking: "Mike\uB97C \uB530\uB77C \uD761\uC5F0\uAD6C\uC5ED\uC73C\uB85C
    \uC774\uB3D9\uD558\uAE30"
  taskSmoke: "Mike\uC640 \uB2F4\uBC30 \uD53C\uC6B0\uAE30"
  taskGoHome: "\uADC0\uAC00\uD558\uAE30"
  taskDinner: "\uC800\uB141\uC2DD\uC0AC \uD558\uAE30"
  taskComputer: "\uCE68\uC2E4\uB85C \uC774\uB3D9\uD574 \uCEF4\uD4E8\uD130 \uCF1C\uAE30"
  taskPlayGame: "\uAC8C\uC784\uD558\uAE30"
  taskSleep: "\uCDE8\uCE68\uD558\uAE30"
  wakeLines:
  - speaker: 0
    text: "...\uB610 \uC544\uCE68\uC774\uB124."
  breakfastDoneLines:
  - speaker: 0
    text: "\uC544\uCE68\uB3C4 \uBA39\uC5C8\uC73C\uB2C8 \uC2AC\uC2AC \uCD9C\uADFC\uD560\uAE4C."
  - speaker: 0
    text: "\uC624\uB298\uC740 Mike\uB791 \uAC19\uC774 \uAC00\uAE30\uB85C \uD588\uC9C0."
  - speaker: 0
    text: "\uBC16\uC73C\uB85C \uB098\uAC00\uC11C \uC55E\uC73C\uB85C \uCB49 \uAC00\uBA74
      \uB098\uC624\uB294\n\uD070\uAE38 \uCABD\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC744 \uAC70\uC57C."
  mikeMeetLines:
  - speaker: 2
    text: "\uC694. \uC774\uC81C \uB098\uC624\uB0D0? \uBA3C\uC800 \uAC00\uB294 \uC904
      \uC54C\uC558\uC796\uC544."
  - speaker: 1
    text: "\uBBF8\uC548. \uC5B4\uC81C \uC880 \uB2A6\uAC8C \uC7A0\uB4E4\uC5C8\uC5B4."
  - speaker: 2
    text: "\uB610 \uAC8C\uC784\uD55C \uAC74 \uC544\uB2C8\uC9C0?"
  - speaker: 1
    text: "\uBB50 \uC5B4\uB54C. \uC9C0\uAC01\uB9CC \uC548 \uD558\uBA74 \uB41C \uAC70
      \uC544\uB2C8\uC57C?"
  - speaker: 2
    text: "\uC548 \uD558\uAE34 \uD558\uC9C0. \uD560 \uBED4\uD55C \uAC74 \uBC31 \uBC88\uCBE4
      \uB418\uACE0."
  - speaker: 2
    text: "\uAC00\uC790. \uB2A6\uACA0\uB2E4."
  workplaceLines:
  - speaker: 2
    text: "\uB09C \uC624\uB298 1\uCE35 \uC791\uC5C5\uAD6C\uC5ED \uB2F4\uB2F9\uC774\uC57C.
      \uB108\uB294?"
  - speaker: 1
    text: "\uB09C \uB298 2\uCE35\uC774\uC9C0.\n\uB2F9\uBD84\uAC04\uC740 \uCB49 2\uCE35
      \uC791\uC5C5\uAD6C\uC5ED\uC5D0 \uAC08 \uAC83 \uAC19\uC544."
  - speaker: 2
    text: "\uBB50, \uBE61\uC138\uC9C4 \uC54A\uC73C\uB2C8\uAE4C \uB2E4\uD589\uC774\uC9C0.\n\uADF8\uB7FC
      \uC11C\uB458\uB7EC \uAC00 \uBD10. \uC624\uB298\uB3C4 \uC801\uB2F9\uD788 \uC77C\uD574\uBCF4\uC790\uACE0."
  - speaker: 1
    text: "\uADF8\uB798. \uC774\uB530\uAC00 \uC810\uC2EC\uB54C \uBCF4\uC790."
  workStartLines:
  - speaker: 0
    text: "\uBC8C\uC368\uBD80\uD130 \uC9D1\uC5D0 \uAC00\uACE0 \uC2F6\uB2E4."
  - speaker: 0
    text: "\uD558\uC9C0\uB9CC \uC77C\uC744 \uD574\uC57C \uD558\uACE0 \uC2F6\uC740
      \uAC8C\uC784 CD\uB3C4 \uC0AC\uACE0,\n\uBC29\uC138\uB3C4 \uB0B4\uACE0 \uD558\uB294
      \uAC70\uB2C8\uAE4C..."
  - speaker: 0
    text: "\uB354 \uBBF8\uB8E8\uC9C0 \uB9D0\uACE0 \uC77C\uC744 \uC2DC\uC791\uD558\uC790."
  morningDoneLines:
  - speaker: 0
    text: "\uD734, \uC624\uC804 \uC791\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0 \uD558\uACE0
      \uC26C\uC5B4\uC57C\uACA0\uC5B4.\n\uBC30\uAC00 \uACE0\uD508\uAC78."
  - speaker: 0
    text: "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uACE7 \uC810\uC2EC\uC2DC\uAC04\uC774\uC57C."
  - speaker: 0
    text: "Mike\uAC00 1\uCE35\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uD14C\uB2C8\n\uC791\uC5C5\uC744
      \uB9C8\uBB34\uB9AC\uD558\uACE0 \uB098\uAC00\uBCF4\uC790."
  lunchLines:
  - speaker: 2
    text: "\uB2E4\uD589\uD788 \uC624\uC804\uC740 \uD6C4\uB531 \uC9C0\uB098\uAC14\uB124.\n\uBC30\uACE0\uD504\uB2E4.
      \uBB50 \uBA39\uC744 \uAC70\uC57C?"
  - speaker: 1
    text: "\uBA40\uB9AC \uAC00\uAE30\uB3C4 \uADC0\uCC2E\uC740\uB370.\n\uADF8\uB0E5
      \uD3B8\uC758\uC810\uC774\uB098 \uAC00\uC790."
  - speaker: 2
    text: "\uADF8\uB7EC\uC9C0 \uBB50.\n\uB098\uB3C4 \uB300\uCDA9 \uBB50 \uC880 \uC0AC
      \uBA39\uC5B4\uC57C\uACA0\uB2E4."
  - speaker: 1
    text: "\uAC00\uC790."
  noFoodExitLines:
  - speaker: 2
    text: "\uC57C, \uC544\uBB34\uAC83\uB3C4 \uC548 \uC0AC?\n\uC624\uD6C4\uC5D0 \uC77C\uD558\uB2E4
      \uC4F0\uB7EC\uC9C4\uB2E4."
  ateInStoreLines:
  - speaker: 2
    text: "\uC5B4\uC9C0\uAC04\uD788 \uBC30\uACE0\uD320\uB098 \uBCF4\uB124."
  leaveStoreLines:
  - speaker: 2
    text: "\uC77C\uD130\uB85C \uB3CC\uC544\uAC00\uC11C \uBC25 \uBA39\uACE0 \uC880
      \uC26C\uC790\uACE0."
  returnLines:
  - speaker: 2
    text: "\uADF8\uB7FC \uC624\uD6C4 \uC77C\uACFC\uB3C4 \uD798\uB0B4\uBCF4\uC790\uACE0."
  - speaker: 1
    text: "\uADF8\uB798. \uC77C \uB2E4 \uB05D\uB098\uACE0 \uBCF4\uC790."
  afternoonDoneLines:
  - speaker: 0
    text: "\uB4DC\uB514\uC5B4 \uB2E4 \uB05D\uB0C8\uB2E4."
  - speaker: 0
    text: "\uBE60\uB974\uAC8C \uB9C8\uBB34\uB9AC\uD558\uACE0 \uD1F4\uADFC\uD558\uC790.\n1\uCE35\uC5D0\uC11C
      Mike\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uAC70\uC57C."
  notClockedOutLines:
  - speaker: 2
    text: "\uD1F4\uADFC \uCE74\uB4DC\uBD80\uD130 \uCC0D\uACE0 \uC640."
  afterWorkLines:
  - speaker: 2
    text: "\uC624\uB298\uB3C4 \uC218\uACE0 \uB9CE\uC558\uC5B4.\n\uC7A0\uC2DC \uB2F4\uBC30\uB098
      \uD55C \uB300 \uD53C\uC6B0\uACE0 \uAC00\uB824\uB294\uB370, \uAC19\uC774 \uAC08\uB798?"
  - speaker: 1
    text: "\uADF8\uB798."
  offerPackLines:
  - speaker: 2
    text: "\uBB50\uC57C. \uB2F4\uBC30 \uC5C6\uC5B4?\n\uB0B4 \uAC70 \uBE4C\uB824\uC904\uAC8C."
  lightUpLines:
  - speaker: 2
    text: "\uC790, \uD55C \uB300 \uD53C\uC6B0\uC790."
  smokingLines:
  - speaker: 2
    text: "\uB0B4\uC77C\uC740 \uC880 \uB4E0\uB4E0\uD55C \uAC70 \uC0AC \uBA39\uC790.\n\uB300\uCDA9
      \uD3B8\uC758\uC810 \uC74C\uC2DD\uC73C\uB85C \uB54C\uC6B0\uB2C8\uAE4C \uBC30\uACE0\uD30C
      \uC8FD\uACA0\uC5B4."
  - speaker: 1
    text: "\uAE00\uC384.\n\uB0B4\uC77C \uD1F4\uADFC\uD558\uBA74\uC11C \uC0C8\uB85C\uC6B4
      \uAC8C\uC784 CD\uB97C \uC0AC\uC57C \uD574\uC11C \uB3C8\uC774 \uB420\uC9C0 \uBAA8\uB974\uACA0\uB124."
  - speaker: 2
    text: "\uB108 \uAC8C\uC784 CD \uC0B0 \uC9C0 \uC5BC\uB9C8 \uC548 \uB418\uC9C0
      \uC54A\uC558\uC5B4?\n\uBC8C\uC368 \uB610 \uC0C8\uB85C\uC6B4 \uAC78 \uC0AC\uB294
      \uAC70\uC57C?"
  - speaker: 1
    text: "\uC751. \uC544\uB9C8 \uC624\uB298 \uC9D1\uC5D0 \uAC00\uC11C \uC5D4\uB529\uC744
      \uBCFC \uAC83 \uAC19\uC544.\n\uADF8\uB7FC \uB610 \uC0C8\uB85C\uC6B4 \uAC78
      \uD574\uC57C\uC9C0."
  - speaker: 2
    text: "\uBC25 \uAD76\uACE0 \uAC8C\uC784\uC744 \uD558\uACA0\uB2E4\uB2C8.\n\uC774\uD574\uD560
      \uC218\uAC00 \uC5C6\uB124."
  - speaker: 1
    text: "\uAD76\uC9C4 \uC54A\uC9C0.\n\uADF8\uB7EC\uB294 \uB108\uB294 \uC220\uB2F4\uBC30\uC5D0
      \uB3C8 \uB2E4 \uAF2C\uB77C\uBC15\uC796\uC544."
  - speaker: 2
    text: "\uB09C \uC0B6\uC758 \uB099\uC774 \uC220\uC774\uC57C."
  - speaker: 1
    text: "\uC5B4\uB828\uD558\uC2DC\uACA0\uC5B4."
  - speaker: 2
    text: "\uB9D0 \uB098\uC628 \uAE40\uC5D0 \uC5B8\uC81C \uC2DC\uAC04 \uB418\uBA74
      \uD1F4\uADFC\uD558\uACE0 \uB9E5\uC8FC\uB098 \uD55C\uC794\uD558\uC790\uACE0.\n\uCD5C\uADFC\uC5D0
      \uC0C8\uB85C \uC5F0 \uD38D\uC774 \uD558\uB098 \uC788\uB294\uB370 \uBD84\uC704\uAE30\uAC00
      \uAF64 \uAD1C\uCC2E\uC544."
  - speaker: 2
    text: "\uC548\uC8FC\uB3C4 \uB9DB\uC788\uACE0."
  - speaker: 1
    text: "\uADF8\uB798. \uADF8\uB7EC\uC9C0 \uBB50."
  - speaker: 2
    text: "\uADF8\uB7FC \uB0B4\uC77C \uB610 \uBCF4\uC790\uACE0.\n\uC870\uC2EC\uD788
      \uB4E4\uC5B4\uAC00\uB77C."
  - speaker: 1
    text: "\uB108\uB3C4 \uC798 \uB4E4\uC5B4\uAC00\uB77C."
  homeLines:
  - speaker: 0
    text: "\uC624\uB298\uB3C4 \uC9C0\uB8E8\uD55C \uD558\uB8E8\uAC00 \uB05D\uB098\uAC00\uB294\uAD70."
  - speaker: 0
    text: "\uAC04\uB2E8\uD558\uAC8C \uC800\uB141\uC744 \uBA39\uACE0,\n\uD558\uB358
      \uAC8C\uC784\uC774\uB098 \uD574\uBCFC\uAE4C?"
  gameEndLines:
  - speaker: 0
    text: "\uB4DC\uB514\uC5B4 \uC5D4\uB529\uC744 \uBD24\uB124.\n\uB098\uB984 \uC7AC\uBC0C\uC5C8\uC5B4."
  - speaker: 0
    text: "\uC2DC\uAC04\uC774 \uBC8C\uC368 \uC774\uB807\uAC8C \uB410\uB2E4\uB2C8.\n\uC774\uC81C
      \uC790\uB7EC \uAC00\uC790."
  beat: 0
  lunchFoodPurchased: 0
  lunchFoodEatenInStore: 0
